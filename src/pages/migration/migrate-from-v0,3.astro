---
import Code from '../../components/Code.astro';
import Aside from '../../components/Aside.astro';
import Footer from '../../components/Footer';
import Header from '../../components/Header.astro';
import Content from '../../layouts/Content.astro';
import Layout from '../../layouts/Layout.astro';
import MainWrapper from '../../layouts/MainWrapper.astro';
---

<Layout title="Migrating from v0.3 | Fluffle">
  <Header />

  <MainWrapper>
    <Aside />

    <main>
      <Content title="Migrating from v0.3">
        <p>v0.4 and later versions remove the configureRem API.</p>

        <h3>Removed</h3>

        <Code
          lang="ts"
          code={`configureRem({ rootFontSize: 12 });
`}
        />

        <h3>What changed?</h3>

        <ul>
          <li>Native rem units now always use 14 as the root size</li>
          <li>Web rem units follow the browser root font size</li>
        </ul>

        <h3>Legacy docs</h3>

        <p>
          Need the old API?
          <a href="/legacy/v0.3/features/rem"> View v0.3 documentation </a>
        </p>
      </Content>
    </main>
  </MainWrapper>

  <Footer />
</Layout>
